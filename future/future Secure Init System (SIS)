================================================================================
USB POLICY EXTENSION
--------------------------------------------------------------------------------

usb {

    default: deny

    allow storage if device.signed == true
    allow hid if device.class == "keyboard" and user.approved == true

    require storage.mount if device.encrypted == true

    quarantine device if device.anomaly_detected == true

    audit usb.attach
    audit usb.detach
}
================================================================================

NETWORK POLICY EXTENSION
--------------------------------------------------------------------------------

network {

    default: deny

    allow outbound if service.network == true

    require tor if service.tag == "anonymous"

    deny clearnet if profile == "anonymous"

    quarantine connection if dns.leak_detected == true

    audit network.connect
}
================================================================================

SERVICE POLICY EXTENSION
--------------------------------------------------------------------------------

service {

    default: deny

    allow start if service.signed == true

    allow start if service.policy_compliant == true

    require start if service.dependencies_met == true

    quarantine service if service.behavior_anomaly == true

    audit service.start
    audit service.stop
}
